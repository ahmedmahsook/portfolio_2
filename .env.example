# ==============================================================================
# ENVIRONMENT VARIABLES SPECIFICATION
# Project: Photographer & Videographer Portfolio
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudinary Credentials (For direct signed chunked uploads and delivery)
# ------------------------------------------------------------------------------
# Your Cloudinary cloud name (already configured as 'driapshxj' if omitted)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=driapshxj

# Cloudinary API Key (Server-side, exposed to client only during signed upload requests)
CLOUDINARY_API_KEY=your_cloudinary_api_key_here

# Cloudinary API Secret (Strictly server-side! Never prefix with NEXT_PUBLIC_)
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Credentials (For persistent video metadata)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://vnbnwedswpgpmwqaxghn.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anonymous Key (Client-safe read-only queries with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here

# Supabase Service Role Secret (Strictly server-side! Used by Next.js API to write/edit/delete)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Owner Private Portal Authentication
# ------------------------------------------------------------------------------
# The private passphrase used by the owner to log in at /upload
UPLOAD_PORTAL_PASSWORD=choose_a_strong_owner_password_here

# Secret used to encrypt/sign the HTTP-only admin session cookie (32+ chars recommended)
SESSION_SECRET=a_random_32_character_secret_key_for_cookie_signing_here
